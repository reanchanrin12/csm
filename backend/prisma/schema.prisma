datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FuelType {
  EV
  PHEV
  HYBRID
  GASOLINE
  DIESEL
}

enum VehicleStatus {
  IN_TRANSIT
  IN_STOCK
  RESERVED
  SOLD
  UNDER_REPAIR
}

enum LoanType {
  FULL_PAYMENT
  INSTALLMENT_FLAT
  INSTALLMENT_DECLINING
  BANK_LOAN
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum EmployeeRole {
  ADMIN
  STOCK_CONTROLLER
  ACCOUNTANT
  SALE
  TECHNICIAN
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  STOCK_CONTROLLER
  ACCOUNTANT
  SALE
  TECHNICIAN
}

enum CostCategory {
  TAX
  CLEARANCE
  TRANSPORT
  CONTAINER
  LABOR
  REPAIR
  ACCESSORY
}

enum SupplierType {
  VEHICLE
  LOGISTICS
  REPAIR
  CUSTOMS
}

model Branch {
  id            String            @id @default(uuid())
  name          String            @unique
  address       String?
  phone1        String?
  phone2        String?
  note          String?
  cars          Vehicle[]         @relation("CurrentBranch")
  employees     Employee[]
  transfersFrom VehicleTransfer[] @relation("SourceBranch")
  transfersTo   VehicleTransfer[] @relation("DestBranch")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model CarBrand {
  id        String     @id @default(uuid())
  name      String     @unique
  models    CarModel[]
  createdAt DateTime   @default(now())
}

model CarModel {
  id        String    @id @default(uuid())
  brandId   String
  brand     CarBrand  @relation(fields: [brandId], references: [id])
  name      String
  vehicles  Vehicle[]
  createdAt DateTime  @default(now())
}

model Supplier {
  id        String          @id @default(uuid())
  nameEn    String
  nameKh    String?
  country   String?
  phone     String?
  phone2    String?
  email     String?
  website   String?
  address   String?
  note      String?
  category  SupplierType    @default(VEHICLE)
  vehicles  Vehicle[]
  bills     LandedCostBill[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Customer {
  id        String      @id @default(uuid())
  name      String
  gender    String?
  dob       DateTime?
  idCard    String?
  phone     String
  email     String?
  address   String?
  job       String?
  note      String?
  sales     SaleOrder[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Employee {
  id             String          @id @default(uuid())
  englishName    String
  khmerName      String?
  gender         String?
  dob            DateTime?
  phone          String
  email          String?         @unique
  idCard         String?
  address        String?
  jobPosition    String?
  role           EmployeeRole    @default(SALE)
  salary         Decimal         @db.Decimal(10, 2)
  startWork      DateTime?
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  note           String?
  sales          SaleOrder[]     @relation("SellerEmployee")
  salaryPayments SalaryPayment[]
  user           User?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model SalaryPayment {
  id           String        @id @default(uuid())
  employeeId   String
  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  paidDate     DateTime      @default(now())
  payAmount    Decimal       @db.Decimal(10, 2)
  actualSalary Decimal       @db.Decimal(10, 2)
  payStatus    String        @default("full payment")
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}


model User {
  id           String    @id @default(uuid())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(SALE)
  isActive     Boolean   @default(true)
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Vehicle {
  id               String            @id @default(uuid())
  vin              String            @unique
  engineNumber     String?
  modelId          String
  model            CarModel          @relation(fields: [modelId], references: [id])
  madeYear         Int
  cylinderDisp     String?
  exteriorColor    String
  interiorColor    String?
  fuelType         FuelType          @default(EV)
  batteryCapacity  String?
  plateNumber      String?
  registrationCard String?
  arrivalDate      DateTime?
  purchasingDate   DateTime?
  witness          String?
  note             String?
  coverImageUrl    String?
  galleryImages    String[]          @default([])
  status           VehicleStatus     @default(IN_STOCK)

  purchaseCost     Decimal           @db.Decimal(12, 2)
  inSalePrice      Decimal?          @db.Decimal(12, 2)

  branchId         String
  currentBranch    Branch            @relation("CurrentBranch", fields: [branchId], references: [id])
  supplierId       String
  supplier         Supplier          @relation(fields: [supplierId], references: [id])

  costItems        VehicleCostItem[]
  transfers        VehicleTransfer[]
  saleOrder        SaleOrder?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([vin])
  @@index([status])
  @@index([branchId])
}

model VehicleCostItem {
  id        String          @id @default(uuid())
  vehicleId String
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  costType  CostCategory
  amount    Decimal         @db.Decimal(12, 2)
  billId    String?
  bill      LandedCostBill? @relation(fields: [billId], references: [id])
  note      String?
  createdAt DateTime        @default(now())
}

model LandedCostBill {
  id          String            @id @default(uuid())
  billNumber  String            @unique
  supplierId  String
  supplier    Supplier          @relation(fields: [supplierId], references: [id])
  category    CostCategory
  totalAmount Decimal           @db.Decimal(12, 2)
  paidAmount  Decimal           @default(0) @db.Decimal(12, 2)
  billDate    DateTime
  description String?
  costItems   VehicleCostItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model VehicleTransfer {
  id             String    @id @default(uuid())
  vehicleId      String
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  sourceBranchId String
  sourceBranch   Branch    @relation("SourceBranch", fields: [sourceBranchId], references: [id])
  destBranchId   String
  destBranch     Branch    @relation("DestBranch", fields: [destBranchId], references: [id])
  transferDate   DateTime  @default(now())
  note           String?
  createdAt      DateTime  @default(now())
}

model SaleOrder {
  id               String          @id @default(uuid())
  receiptNo        String          @unique
  vehicleId        String          @unique
  vehicle          Vehicle         @relation(fields: [vehicleId], references: [id])
  customerId       String
  customer         Customer        @relation(fields: [customerId], references: [id])
  sellerEmployeeId String?
  sellerEmployee   Employee?       @relation("SellerEmployee", fields: [sellerEmployeeId], references: [id])
  soldPrice        Decimal         @db.Decimal(12, 2)
  paidAmount       Decimal         @default(0) @db.Decimal(12, 2)
  bookPrice        Decimal         @default(0) @db.Decimal(12, 2)
  returnMoneyDate  DateTime?
  paymentNotice    String?
  bankName         String?
  bankApprovalRef  String?
  soldDate         DateTime        @default(now())
  loanType         LoanType        @default(FULL_PAYMENT)
  interestRate     Decimal?        @db.Decimal(5, 2)
  termMonths       Int?
  disbursementDate DateTime?

  schedules        LoanSchedule[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model LoanSchedule {
  id            String        @id @default(uuid())
  saleOrderId   String
  saleOrder     SaleOrder     @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  installmentNo Int
  dueDate       DateTime
  principal     Decimal       @db.Decimal(12, 2)
  interest      Decimal       @db.Decimal(12, 2)
  totalDue      Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  penalty       Decimal       @default(0) @db.Decimal(12, 2)
  paidDate      DateTime?
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
}

model OperatingExpense {
  id          String   @id @default(uuid())
  expenseDate DateTime
  expenseTo   String
  amount      Decimal  @db.Decimal(12, 2)
  details     String?
  createdAt   DateTime @default(now())
}

model CompanyProfile {
  id        String   @id @default(uuid())
  name      String
  gender    String?
  dob       DateTime?
  phone     String?
  job       String?
  email     String?
  address   String?
  logoUrl   String?
  note      String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
